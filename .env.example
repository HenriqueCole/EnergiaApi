# Copie para .env e ajuste o que precisar. O .env nao vai pro git.
# Este arquivo e o ambiente local de desenvolvimento.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
DB_PORT=1433
DB_NAME=EnergiaDb

# Senha do usuario sa do SQL Server. Em staging e producao vem do GitHub Secrets.
DB_PASSWORD=Energia@2026!

# Chave usada para assinar o JWT. Precisa de no minimo 32 caracteres.
JWT_KEY=minha-chave-super-secreta-com-no-minimo-32-caracteres!!

# Imagem que o compose vai usar. Se ficar vazio, ele constroi local.
# No deploy vira ghcr.io/<usuario>/<repo>:<sha>
# API_IMAGE=
APP_VERSION=local
