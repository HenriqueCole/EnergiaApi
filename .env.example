# Copie para .env e ajuste. Nao comite o .env (ja esta no .gitignore).
# Ambiente local de desenvolvimento.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
DB_PORT=1433
DB_NAME=EnergiaDb

# Senha do SA do SQL Server. Em staging/producao vem do GitHub Secrets.
DB_PASSWORD=Energia@2026!

# Chave de assinatura do JWT (minimo 32 caracteres).
JWT_KEY=minha-chave-super-secreta-com-no-minimo-32-caracteres!!

# Imagem usada pelo compose. Vazio/ausente = build local.
# Em deploy: ghcr.io/<usuario>/<repo>:<sha>
# API_IMAGE=
APP_VERSION=local
