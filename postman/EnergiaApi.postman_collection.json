{
  "info": {
    "name": "EnergiaApi",
    "description": "Webservice ESG de eficiência energética - ASP.NET Core 8.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base}}/api/auth/login",
          "host": ["{{base}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Consumos - Lista paginada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api/consumos?page=1&pageSize=20",
          "host": ["{{base}}"],
          "path": ["api", "consumos"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Leituras - Registrar (JWT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipamentoId\": 1,\n  \"consumoKwh\": 15\n}"
        },
        "url": {
          "raw": "{{base}}/api/leituras",
          "host": ["{{base}}"],
          "path": ["api", "leituras"]
        }
      }
    },
    {
      "name": "Relatorios - Por equipamento",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api/relatorios/equipamento/1",
          "host": ["{{base}}"],
          "path": ["api", "relatorios", "equipamento", "1"]
        }
      }
    },
    {
      "name": "Alertas - Lista paginada (JWT)",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "url": {
          "raw": "{{base}}/api/alertas?page=1&pageSize=20",
          "host": ["{{base}}"],
          "path": ["api", "alertas"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "20" }
          ]
        }
      }
    }
  ]
}
